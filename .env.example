# Optional. The radar works fully without these (read-only public market data).
# Set them only if you want the live LLM analyst layer (OpenAI-compatible endpoint).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Kalshi trading/private endpoints need an RSA-signed key pair; market listing does not.
# KALSHI_API_KEY=
# KALSHI_PRIVATE_KEY_PATH=
