# Optional. The radar works fully without these (read-only public market data).
# Set them only if you want the live LLM analyst layer (OpenAI-compatible endpoint).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Kalshi trading/private endpoints need an RSA-signed key pair; market listing does not.
# KALSHI_API_KEY=
# KALSHI_PRIVATE_KEY_PATH=

# Optional network proxy. Replace this example with your own proxy address.
# Export these variables in the shell; this project does not auto-load .env files.
# HTTP_PROXY=http://127.0.0.1:17891
# HTTPS_PROXY=http://127.0.0.1:17891
